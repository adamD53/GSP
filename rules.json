[
  {
    "id": "fatal-or-critical",
    "name": "Fatal Severity Log",
    "description": "Triggers 24/7 email and SMS alerts on any FATAL log event.",
    "severity": "critical",
    "enabled": true,
    "notify": [
      { "channel": "email", "to": "oncall@example.com" },
      { "channel": "sms", "to": "+15550001234", "working_hours_only": false }
    ],
    "field": "/level",
    "operator": "eq",
    "value": "FATAL"
  },
  {
    "id": "high-latency-error",
    "name": "High-Latency Error",
    "description": "Emails anytime; sends SMS only during working hours when ERROR/FATAL latency > 3000ms.",
    "severity": "high",
    "enabled": true,
    "notify": [
      { "channel": "email", "to": "backend-alerts@example.com" },
      { "channel": "sms", "to": "+15550001234", "working_hours_only": true }
    ],
    "all": [
      {
        "field": "/level",
        "operator": "in",
        "value": ["ERROR", "FATAL"]
      },
      {
        "field": "/metadata/latency_ms",
        "operator": "gt",
        "value": 3000
      }
    ]
  },
  {
    "id": "auth-or-db-failure",
    "name": "Auth or Database Failure",
    "description": "Emails anytime; SMS only during working hours on auth or DB timeout.",
    "severity": "high",
    "enabled": true,
    "notify": ["email", "sms_working_hours"],
    "any": [
      {
        "field": "/message",
        "operator": "contains",
        "value": "Failed password"
      },
      {
        "field": "/message",
        "operator": "contains",
        "value": "timed out"
      }
    ]
  },
  {
    "id": "low-stock-warning",
    "name": "Low Inventory Threshold",
    "description": "Sends email alert when inventory-sync reports remaining stock <= 5.",
    "severity": "medium",
    "enabled": true,
    "notify": [
      { "channel": "email", "to": "ops-inventory@example.com" }
    ],
    "all": [
      {
        "field": "/service",
        "operator": "eq",
        "value": "inventory-sync"
      },
      {
        "field": "/metadata/remaining",
        "operator": "lte",
        "value": 5
      }
    ]
  }
]
